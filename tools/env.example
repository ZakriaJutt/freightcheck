# Copy to .env.local (git-ignored) with `make env`. Synthetic local values only; no secret is
# kept in git. `make env` fills the two random keys; put the local MinIO keys in by hand.
FC_ENV=dev
FC_DATABASE_URL=postgresql+psycopg://freightcheck_app@localhost:5432/freightcheck_dev
FC_MIGRATION_DATABASE_URL=postgresql+psycopg://zakria@localhost:5432/freightcheck_dev
FC_PUBLIC_BASE_URL=http://localhost:8102
FC_SIGNING_KEY=replace-with-random-64-hex
FC_DATA_KEY=replace-with-random-data-key
FC_API_PORT=8102
FC_LOG_LEVEL=INFO
FC_STORAGE_DIR=.local/storage
# Object storage through the S3 API (local MinIO; bucket freightcheck-dev exists).
FC_STORAGE_BACKEND=s3
FC_S3_ENDPOINT=http://127.0.0.1:9000
FC_S3_REGION=us-east-1
FC_S3_BUCKET=freightcheck-dev
FC_S3_ACCESS_KEY=
FC_S3_SECRET_KEY=
# Outgoing mail through SMTP (local Mailpit, no authentication; UI at http://127.0.0.1:8025).
FC_SMTP_HOST=127.0.0.1
FC_SMTP_PORT=1025
FC_SMTP_STARTTLS=false
FC_MAIL_FROM=FreightCheck <no-reply@freightcheck.example>
